# Relay server as a system service:
#   sudo cp contrib/teamlooker-relay.service /etc/systemd/system/
#   sudo systemctl enable --now teamlooker-relay
[Unit]
Description=TeamLooker relay server
After=network-online.target

[Service]
ExecStart=/usr/local/bin/teamlooker relay --bind 0.0.0.0 --port 7575
DynamicUser=yes
Restart=always

[Install]
WantedBy=multi-user.target
